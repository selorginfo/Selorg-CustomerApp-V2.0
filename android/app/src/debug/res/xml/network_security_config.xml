<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Release uses the main config, which denies cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
