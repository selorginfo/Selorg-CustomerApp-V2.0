# Copy to env/selorg/.env.production (gitignored) and fill the keys.
# Until that file exists, `npm run env:prod` uses the root .env.production.
BRAND_KEY=selorg
APP_ENV=production
APP_MODE=production

DEV_API_BASE_URL=https://api.selorg.com/api/v1/customer
PROD_API_BASE_URL=https://api.selorg.com/api/v1/customer
API_BASE_URL=https://api.selorg.com/api/v1/customer

PAYMENT_API_BASE_URL=https://api.selorg.com
PAYMENT_STANDALONE_MODE=gateway

GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EAS_PROJECT_ID=
