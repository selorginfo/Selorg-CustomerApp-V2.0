# Copy to env/sodakku/.env.development (gitignored).
# Customer API hosts must be Sodakku's own (not a selorg.com host).
# Leave Maps and PAYMENT_API_BASE_URL blank to use Selorg's existing values.
BRAND_KEY=sodakku
APP_ENV=development
APP_MODE=development

DEV_API_BASE_URL=
PROD_API_BASE_URL=
API_BASE_URL=

PAYMENT_STANDALONE_MODE=gateway
EAS_PROJECT_ID=
