# Copy to env/sodakku/.env.production (gitignored) and fill every value.
# Blank values are not yet provided for Sodakku. Do not paste Selorg hosts or keys:
# the app refuses to start with a selorg.com API host while BRAND_KEY=sodakku.
BRAND_KEY=sodakku
APP_ENV=production
APP_MODE=production

DEV_API_BASE_URL=
PROD_API_BASE_URL=
API_BASE_URL=

PAYMENT_API_BASE_URL=
PAYMENT_STANDALONE_MODE=gateway

GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EAS_PROJECT_ID=
